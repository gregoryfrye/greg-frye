{
  "$about": "Source of truth for gregfrye.us tokens. Edit here, then run `npm run tokens:build` to regenerate app/tokens.css (never hand-edit that file). Why-files beside this one explain each area. Values seeded from the 2026 Figma (file 19deN2JJWs7hvt12Z0neT4): 00_Index_1280 for the homepage, 01_Client_1280 for case studies.",

  "primitives": {
    "color": {
      "white": "#ffffff",
      "black": "#000000",
      "field": "#998060"
    },
    "alpha": {
      "black-85": "rgb(0 0 0 / 0.85)",
      "black-60": "rgb(0 0 0 / 0.6)",
      "black-25": "rgb(0 0 0 / 0.25)",
      "black-06": "rgb(0 0 0 / 0.06)"
    },
    "typeScale": [6, 9, 12, 15, 18, 21, 27, 36, 45, 54, 72, 90, 108],
    "space": [9, 18, 27, 36, 45, 54, 72, 90, 108],
    "breakpoints": { "xs": 320, "sm": 640, "md": 960, "lg": 1280, "xl": 1600, "2xl": 1920 },
    "fonts": {
      "serif": "\"Times New Roman\", Times, serif",
      "sans": "Helvetica, \"Helvetica Neue\", Arial, sans-serif",
      "mono": "ui-monospace, \"SF Mono\", Menlo, Consolas, monospace"
    },
    "viewport": { "compact": 375, "expanded": 1280 }
  },

  "semantic": {
    "color": {
      "canvas": { "value": "white", "job": "Case studies and inner pages" },
      "canvas-home": { "value": "field", "job": "Homepage field" },
      "ink": { "value": "black", "job": "Primary text, rules, focus" },
      "muted": { "value": "black-60", "job": "Secondary text on canvas" },
      "muted-home": { "value": "black-85", "job": "Secondary text on the field (60% is 3.3:1 there; 85% clears AA at 4.7:1)" },
      "faint": { "value": "black-25", "job": "Inactive index items, as in Figma. Fails AA for text (about 1.9:1): decide in the Visual Design Pass" },
      "border": { "value": "black", "job": "Rules and outlines" },
      "placeholder": { "value": "black-06", "job": "Image boxes while loading and placeholder slots" }
    }
  },

  "layout": {
    "spacing": {
      "nav": { "value": 27, "job": "Nav padding" },
      "gutter": { "value": 27, "job": "Page gutter and column gap" },
      "item": { "value": 9, "job": "Between lines in a list or index" },
      "inline": { "value": 18, "job": "Between items in a row" },
      "block": { "value": 27, "job": "Between blocks inside a section" },
      "section": { "value": 45, "job": "Section padding top and bottom" }
    },
    "containers": {
      "wide": { "value": 1280, "job": "Layout: anything with horizontal structure" },
      "prose": { "value": 672, "job": "Reading measure for continuous text" },
      "hero": { "value": 768, "job": "Homepage headline only" }
    }
  },

  "type": {
    "$about": "Roles bundle family, weight, style, size, line height and tracking. Sizes are px at the compact (375) and expanded (1280) viewports and scale fluidly between. Compact sizes are provisional until the Visual Design Pass.",
    "roles": {
      "title": { "family": "serif", "size": [54, 108], "lineHeight": 0.9, "tracking": "-0.015em", "job": "Case study name" },
      "display": { "family": "serif", "size": [36, 72], "lineHeight": 0.9, "tracking": "-0.015em", "job": "Big statements in the spine" },
      "stat": { "family": "serif", "size": [45, 72], "lineHeight": 0.95, "tracking": "-0.01em", "job": "Stat figures" },
      "body": { "family": "serif", "size": [18, 27], "lineHeight": 1.15, "tracking": "-0.01em", "job": "Reading text and ledes" },
      "label": { "family": "serif", "size": [15, 21], "lineHeight": 1.15, "tracking": "-0.01em", "job": "Nav, chapter index, beat labels, stat captions" },
      "credit": { "family": "serif", "style": "italic", "size": [18, 27], "lineHeight": 1.08, "tracking": "-0.01em", "job": "Photo and project credits" },
      "meta": { "family": "sans", "size": [15, 15], "lineHeight": 1.2, "tracking": "0", "job": "Dates (cards, roles)" }
    },
    "legacy": {
      "$about": "Pre-kit sizes still used by current components. The Visual Design Pass moves components onto roles, then these are deleted.",
      "display": { "size": "clamp(2.5rem, 5.625vw, 4.5rem)", "lineHeight": 1.125 },
      "heading": { "size": "clamp(1.375rem, 2.1vw, 1.6875rem)", "lineHeight": 1.2 },
      "body": { "size": "clamp(1rem, 1.3vw, 1.125rem)", "lineHeight": 1.35 },
      "caption": { "size": "1.125rem", "lineHeight": 1.3 },
      "meta": { "size": "0.9375rem", "lineHeight": 1.2 },
      "tracking-tight": "-0.01em"
    }
  },

  "motion": {
    "ease": {
      "standard": { "value": "cubic-bezier(0.4, 0, 0.2, 1)", "job": "Default for state changes" },
      "enter": { "value": "cubic-bezier(0, 0, 0.2, 1)", "job": "Things arriving" },
      "exit": { "value": "cubic-bezier(0.4, 0, 1, 1)", "job": "Things leaving" },
      "editorial": { "value": "cubic-bezier(0.22, 1, 0.36, 1)", "job": "Image and text reveals" }
    },
    "duration": {
      "fast": { "value": 120, "job": "Hover, focus, small UI" },
      "normal": { "value": 240, "job": "Menus, index highlight, leaving" },
      "slow": { "value": 800, "job": "Reveals" }
    }
  },

  "line": {
    "weight": { "value": 1, "job": "Rules, dividers, outlines and line drawings (the globe)" }
  }
}

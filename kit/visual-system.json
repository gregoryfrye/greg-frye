  "type": {
    "$about": "Core roles shared across Greg's projects (site-design-pipeline): display, headline, title, deck, body, label, caption. Each bundles family, weight, style, size, line height and tracking. Sizes are px [compact, expanded]: compact below md (960), expanded at md and up, matching Figma's Layout modes. Variants (type-<role>-<variant>) override only what differs. Compact sizes are provisional until the Visual Design Pass.",
    "roles": {
      "display": {
        "family": "serif",
        "size": [
          54,
          108
        ],
        "lineHeight": 0.9,
        "tracking": "-0.015em",
        "job": "The biggest, about one per page: case study name, hero"
      },
      "headline": {
        "family": "serif",
        "size": [
          36,
          72
        ],
        "lineHeight": 0.9,
        "tracking": "-0.015em",
        "job": "Big statements and section openers; stat figures"
      },
      "title": {
        "family": "serif",
        "size": [
          27,
          45
        ],
        "lineHeight": 1.05,
        "tracking": "-0.01em",
        "job": "Card and block titles"
      },
      "deck": {
        "family": "serif",
        "size": [
          21,
          36
        ],
        "lineHeight": 1.2,
        "tracking": "-0.01em",
        "job": "Summary line under a title"
      },
      "body": {
        "family": "serif",
        "size": [
          18,
          27
        ],
        "lineHeight": 1.15,
        "tracking": "-0.01em",
        "job": "Reading text",
        "variants": {
          "lede": {
            "size": [
              21,
              36
            ],
            "lineHeight": 1.2,
            "job": "A larger first paragraph, when a piece opens without a deck"
          },
          "small": {
            "size": [
              18,
              18
            ],
            "lineHeight": 1.35,
            "job": "Small reading text that wraps (role rows): label size with reading line height"
          }
        }
      },
      "label": {
        "family": "serif",
        "size": [
          18,
          18
        ],
        "lineHeight": 1.15,
        "tracking": "-0.01em",
        "job": "Nav, CTAs, index, markers, tags, stat captions, card titles"
      },
      "caption": {
        "family": "sans",
        "size": [
          15,
          15
        ],
        "lineHeight": 1.2,
        "tracking": "0",
        "job": "Dates and small notes: the standard date treatment",
        "variants": {
          "credit": {
            "family": "serif",
            "style": "italic",
            "size": [
              18,
              27
            ],
            "lineHeight": 1.08,
            "tracking": "-0.01em",
            "job": "Photo and project credits"
          }
        }
      }
    },
    "legacy": {
      "$about": "Pre-kit sizes still used by current components. The Visual Design Pass moves components onto roles, then these are deleted.",
      "display": {
        "size": "clamp(2.5rem, 5.625vw, 4.5rem)",
        "lineHeight": 1.125
      },
      "heading": {
        "size": "clamp(1.375rem, 2.1vw, 1.6875rem)",
        "lineHeight": 1.2
      },
      "body": {
        "size": "clamp(1rem, 1.3vw, 1.125rem)",
        "lineHeight": 1.35
      },
      "caption": {
        "size": "1.125rem",
        "lineHeight": 1.3
      },
      "meta": {
        "size": "0.9375rem",
        "lineHeight": 1.2
      },
      "tracking-tight": "-0.01em"
    }
  },
  "motion": {
    "ease": {
      "standard": {
        "value": "cubic-bezier(0.4, 0, 0.2, 1)",
        "job": "Default for state changes"
      },
      "enter": {
        "value": "cubic-bezier(0, 0, 0.2, 1)",
        "job": "Things arriving"
      },
      "exit": {
        "value": "cubic-bezier(0.4, 0, 1, 1)",
        "job": "Things leaving"
      },
      "editorial": {
        "value": "cubic-bezier(0.22, 1, 0.36, 1)",
        "job": "Image and text reveals"
      }
    },
    "duration": {
      "fast": {
        "value": 120,
        "job": "Hover, focus, small UI"
      },
      "normal": {
        "value": 240,
        "job": "Menus, index highlight, leaving"
      },
      "slow": {
        "value": 800,
        "job": "Reveals"
      }
    }
  },
  "line": {
    "weight": {
      "value": 1,
      "job": "Rules, dividers, outlines and line drawings (the globe)"
    }
  }
}
